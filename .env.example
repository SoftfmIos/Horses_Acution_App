# Node.js 24+ required. Keep the database on a persistent disk.
PORT=3001
DATABASE_PATH=./data/academy.sqlite
# Required only with NODE_ENV=production; exact HTTPS site origin, no trailing slash.
# PUBLIC_ORIGIN=https://academy.example.com
# Optional SMTP delivery; in-app notifications work without these.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
