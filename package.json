{
  "name": "riyadh-polo-club-academy",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "format": "prettier --write src server api scripts tests vite.config.js vercel.json",
    "test:browser": "node tests/browser.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test:save-race": "node tests/save-race.mjs",
    "test:stable-browser": "node tests/stable-features.mjs",
    "version:next": "npm version minor --no-git-tag-version"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.383.0",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
